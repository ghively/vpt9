{
  "name": "vpt-control-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React operator UI for the VPT modernization control plane — the panel that drives layers, warp, PiP and presets over the control-plane WebSocket.",
  "main": "dist-lib/index.js",
  "module": "dist-lib/index.js",
  "types": "dist-lib/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "build:lib": "vite build -c vite.lib.config.ts && node scripts/build-lib-css.mjs",
    "preview": "vite preview --port 8082 --host",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
